<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- The QR code `ducter pair` prints (asked for only when you tap Scan). -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <!-- D181: the app updates itself from the GitHub Release. Android asks once whether Ducter
         may install apps; after that an update needs one tap (or none, where Android allows). -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" />
    <!-- D246: Android 13+ asks before an app shows notifications. Ducter's one today is the loan's
         (用这台手机, with Stop); asked once, when that is turned on (Notify.kt). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- D255: while a task borrows this phone, the app keeps its own link to the home in a foreground
         service (the loan's notification), and records the screen when a task asks (Android's own
         dialog asks the person each time). specialUse: no other type fits a phone the home drives
         while lent; mediaProjection only while recording. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />

    <!-- D238: a task opens apps on this phone by name (phone_apps): the launcher's list only. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Ducter"
        android:networkSecurityConfig="@xml/network_security_config"
        android:enableOnBackInvokedCallback="true"
        android:localeConfig="@xml/locales_config">

        <!-- One activity, one web view (D178). It is never recreated by turning, folding,
             unfolding or resizing: the page lays itself out again in place and keeps what you
             typed, the route and the open sheet (D176, D182). Light/dark does recreate it:
             the page and the app's own screens take their colors from the theme. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:resizeableActivity="true"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation|density|fontScale|locale|layoutDirection">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- The launcher's long-press "Check for updates" (a dynamic shortcut). -->
            <intent-filter>
                <action android:name="co.nowledge.ducter.CHECK_UPDATE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- D206: a photo taken for the conversation is handed to the camera through this. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/shared_files" />
        </provider>

        <!-- D238: 用这台手机 / Use this phone. Switched on once in Android's settings (the page's
             guide); bound by the system from then on, but it reads and does nothing outside a
             loan the person said yes to (Handset.kt). -->
        <service
            android:name=".HandsetService"
            android:exported="false"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/handset_service" />
        </service>

        <!-- D255: the lent phone's own link to the home (HandsetLink.kt), and the recorder's consent. -->
        <service
            android:name=".HandsetLinkService"
            android:exported="false"
            android:foregroundServiceType="specialUse|mediaProjection">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="While the person lends this phone to a task (they said yes on a card), the home drives it through Ducter's accessibility service: this keeps that connection, shows the loan with Stop, and ends when the loan does." />
        </service>
        <activity
            android:name=".RecordActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- D246: 停下 / Stop in the loan's notification. -->
        <receiver
            android:name=".HandsetStopReceiver"
            android:exported="false" />

        <!-- Where Android reports how an update's install went (PackageInstaller). -->
        <receiver
            android:name=".InstallReceiver"
            android:exported="false" />

        <!-- zxing's scanner, upright like the camera app. -->
        <activity
            android:name="com.journeyapps.barcodescanner.CaptureActivity"
            android:screenOrientation="fullSensor"
            tools:replace="screenOrientation" />
    </application>
</manifest>
