<?xml version="1.0" encoding="utf-8"?>
<!-- A home on the local network or through an SSH tunnel is plain http (http://10.0.0.5:7880),
     as the iPhone app allows. The updater itself only ever asks over https (Updater.kt). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
