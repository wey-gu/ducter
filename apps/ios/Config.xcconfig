// Defaults for the Ducter iPhone app. To sign with your own team or bundle id, put overrides in
// Local.xcconfig next to this file (gitignored), e.g.
//   DEVELOPMENT_TEAM = ABCDE12345
//   DUCTER_BUNDLE_ID = com.example.ducter
DUCTER_BUNDLE_ID = co.nowledge.ducter.ios
DEVELOPMENT_TEAM = JMU55RJW2K
// The notification relay the app registers with (D159). A self-signed build with its own APNs key
// on its home can leave it: the home sends straight to Apple. ("/$()/" keeps "//" from being a comment.)
DUCTER_PUSH_RELAY = https:/$()/ducter.ai/api/push
// D306: the Lock Screen glance (Live Activities). Off until its push path is checked on a real
// iPhone; 1 turns it on (the Simulator shots build with it on).
DUCTER_LIVE_ACTIVITIES = 0
// D553: the share sheet (DucterShare, D537) and the app group on the app. 0 builds the app without
// both, for an account whose App IDs don't have the App Group yet (design/release/ios.md step 5):
// scripts/ci/testflight.sh falls back to it when the export can't make their profiles. Without the
// group the app keeps its pairing to itself and the share outbox is never filled.
DUCTER_SHARE = 1
DUCTER_APP_ENTITLEMENTS_1 = Ducter/Ducter.entitlements
DUCTER_APP_ENTITLEMENTS_0 = Ducter/DucterNoShare.entitlements
DUCTER_SHARE_EXCLUDED_1 =
DUCTER_SHARE_EXCLUDED_0 = DucterShare.appex
#include? "Local.xcconfig"
