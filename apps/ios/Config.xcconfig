// Defaults for the Ducter iPhone app. To sign with your own team or bundle id, put overrides in
// Local.xcconfig next to this file (gitignored), e.g.
//   DEVELOPMENT_TEAM = ABCDE12345
//   DUCTER_BUNDLE_ID = com.example.ducter
DUCTER_BUNDLE_ID = co.nowledge.ducter.ios
DEVELOPMENT_TEAM = JMU55RJW2K
// The notification relay the app registers with (D159). A self-signed build with its own APNs key
// on its home can leave it: the home sends straight to Apple. ("/$()/" keeps "//" from being a comment.)
DUCTER_PUSH_RELAY = https:/$()/ducter.ai/api/push
#include? "Local.xcconfig"
