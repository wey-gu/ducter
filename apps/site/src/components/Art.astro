---
// A pre-rendered clay asset (or screenshot) as AVIF/WebP with intrinsic size, so the browser
// reserves its box before it loads.
import manifest from "../art.json";
import { artUrl } from "../lib/artUrl";

interface Props {
  name: keyof typeof manifest;
  alt: string;
  sizes: string;
  class?: string;
  id?: string;
  style?: string;
  loading?: "eager" | "lazy";
  eager?: boolean;
  [key: `data-${string}`]: string | undefined;
}
const { name, alt, sizes, class: cls, id, style, loading, eager = false, ...rest } = Astro.props;
const a = manifest[name];
const set = (ext: string) => a.widths.map((w) => `${artUrl(`${name}-${w}.${ext}`)} ${w}w`).join(", ");
const fallback = artUrl(`${name}-${a.widths[a.widths.length - 1]}.webp`);
---
<picture class={cls} id={id} style={style} {...rest}>
  <source type="image/avif" srcset={set("avif")} sizes={sizes} />
  <img
    src={fallback}
    srcset={set("webp")}
    sizes={sizes}
    width={a.w}
    height={a.h}
    alt={alt}
    loading={loading ?? (eager ? "eager" : "lazy")}
    decoding="async"
    fetchpriority={eager ? "high" : undefined}
    draggable="false"
  />
</picture>
