---
import Art from "./Art.astro";
interface Props { gh: { href: string }; home?: boolean }
const { gh, home = true } = Astro.props;
const at = (h: string) => (h.startsWith("#") && !home ? "/" + h : h);
---
<footer>
  <div class="wrap">
    <a class="brand" href="/" style="font-size:18px"><Art name="ducter_idle" alt="" sizes="34px" />Ducter</a>
    <nav aria-label="Footer">
      <a href="/start">Get started</a>
      <a href="/download">Download</a>
      <a href="/docs">Docs</a>
      <a href={at("#trust")}>Trust</a>
      <a href={gh.href} rel="noopener">GitHub</a>
      <a href="/changelog">What's new</a>
      <a href={`${gh.href}#under-the-hood`} rel="noopener">How it's built</a>
      <span class="footer-family">
        <a href="https://mem.nowledge.co" rel="noopener">Nowledge Mem</a>
        <a href="https://con.nowledge.co" rel="noopener">con</a>
      </span>
    </nav>
    <span>© 2026 the Ducter authors. Free under the Apache 2.0 license.</span>
  </div>
</footer>
