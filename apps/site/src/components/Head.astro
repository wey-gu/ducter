---
interface Props { title: string; description: string; path?: string; ld?: object }
const { title, description, path = "/", ld } = Astro.props;
const url = new URL(path, "https://ducter.ai").toString();
---
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={url} />
  <meta name="color-scheme" content="light dark" />
  <meta name="theme-color" content="#FFF6EA" media="(prefers-color-scheme: light)" />
  <meta name="theme-color" content="#17120E" media="(prefers-color-scheme: dark)" />
  <link rel="icon" href="/favicon.ico" sizes="32x32" />
  <link rel="icon" href="/icon.png" type="image/png" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="manifest" href="/site.webmanifest" />
  <link rel="preload" href="/fonts/bricolage.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/fonts/instrument-sans.woff2" as="font" type="font/woff2" crossorigin />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Ducter" />
  <meta property="og:url" content={url} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content="https://ducter.ai/og.png?v=3" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="The words Your own personal AI. It does the work, and asks only when it matters. Beside them, a real screen of Ducter: a morning note with two things that need you, above an errand it finished (a dinner table for four, booked), and its orange clay character beside the screen." />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content="https://ducter.ai/og.png?v=3" />
  <script is:inline>document.documentElement.classList.add("js")</script>
  {ld && <script type="application/ld+json" set:html={JSON.stringify(ld)} />}
</head>
