---
import Art from "./Art.astro";
import GitHubMark from "./GitHubMark.astro";
// D326: the button is Get started (one guided path); Download, the full list of files, is a link.
interface Props { dl: { href: string; label: string }; gh: { href: string; label: string }; home?: boolean; current?: "docs" | "download" | "start" }
const { gh, home = true, current } = Astro.props;
const at = (hash: string) => (home ? hash : "/" + hash);
---
<a class="skip" href="#main">Skip to content</a>
<header class="nav" id="nav">
  <div class="wrap">
    <a class="brand" href="/" aria-label="Ducter home">
      <Art name="ducter_idle" alt="" sizes="34px" eager />
      Ducter
    </a>
    <nav class="nav-links" aria-label="Sections">
      <a href={at("#what")}>What it does</a>
      <a href={at("#trust")}>Trust</a>
      <a href="/docs" aria-current={current === "docs" ? "page" : undefined}>Docs</a>
      <a href="/download" aria-current={current === "download" ? "page" : undefined}>Download</a>
    </nav>
    <a class="nav-gh" href={gh.href} rel="noopener" aria-label="Ducter on GitHub"><GitHubMark /><span>{gh.label}</span></a>
    <a class="btn md nav-dl" href="/start" aria-current={current === "start" ? "page" : undefined}>Get started</a>
  </div>
</header>
