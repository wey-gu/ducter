---
import "../styles/site.css";
import Head from "../components/Head.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import { siteLinks } from "../lib/links";
import { docHref, docLabel, groupDocs, type Doc } from "../lib/docs";

interface Heading { depth: number; slug: string; text: string }
interface Props { doc: Doc | null; docs: Doc[]; headings?: Heading[] }
const { doc, docs, headings = [] } = Astro.props;
const { dl, gh } = await siteLinks();
const title = doc?.data.title ?? "Ducter docs";
const description = doc?.data.description ?? "How to install Ducter and work with your partner on your own computers.";
const path = doc ? docHref(doc) : "/docs";
const readme = docs.find((d) => d.id === "readme");
const groups = groupDocs(docs, readme?.body ?? "");
// Previous and next follow the sidebar, so reading straight through goes group by group.
const order = groups.flatMap((g) => g.docs);
const i = doc ? order.findIndex((d) => d.id === doc.id) : -1;
const prev = i > 0 ? order[i - 1] : null;
const next = i >= 0 && i < order.length - 1 ? order[i + 1] : null;
// On this page: the h2s of a page long enough to need them.
const toc = headings.filter((h) => h.depth === 2);
const showToc = toc.length >= 3;
---
<!doctype html>
<html lang="en">
<Head title={doc && doc.id !== "readme" ? `${title} – Ducter docs` : title} description={description} path={path} />
<body class="docs-page">
<Nav dl={dl} gh={gh} home={false} current="docs" />
<main id="main" class:list={["wrap docs", { "has-toc": showToc }]}>
  <aside class="docs-nav">
    <details class="docs-toc" open>
      <summary>All docs</summary>
      <nav aria-label="Docs">
        {groups.map((g) => (
          <div class="docs-group">
            <p class="docs-group-title">{g.title}</p>
            <ol>
              {g.docs.map((d) => (
                <li><a href={docHref(d)} aria-current={doc?.id === d.id ? "page" : undefined}>{docLabel(d)}</a></li>
              ))}
            </ol>
          </div>
        ))}
      </nav>
    </details>
  </aside>
  <article class="prose">
    <h1>{title}</h1>
    {doc?.data.description && <p class="lede">{doc.data.description}</p>}
    {showToc && (
      <details class="onpage onpage-inline">
        <summary>On this page</summary>
        <ol>{toc.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol>
      </details>
    )}
    <slot />
    {(prev || next) && (
      <nav class="pager" aria-label="More docs">
        {prev ? <a href={docHref(prev)}><small>Previous</small>{docLabel(prev)}</a> : <span></span>}
        {next && <a class="next" href={docHref(next)}><small>Next</small>{docLabel(next)}</a>}
      </nav>
    )}
  </article>
  {showToc && (
    <aside class="onpage onpage-rail" aria-label="On this page">
      <p class="docs-group-title">On this page</p>
      <ol>{toc.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol>
    </aside>
  )}
</main>
<Footer gh={gh} home={false} />
<script>
  import { copyButtons, navLine } from "../scripts/common";
  navLine();
  // the sidebar starts collapsed on small screens
  if (matchMedia("(max-width: 899px)").matches) document.querySelector(".docs-toc")?.removeAttribute("open");
  // every code block gets a Copy button
  document.querySelectorAll<HTMLPreElement>(".prose pre").forEach((pre) => {
    const box = document.createElement("div");
    box.className = "codebox";
    pre.replaceWith(box);
    const b = document.createElement("button");
    b.type = "button";
    b.className = "btn sm copy";
    b.dataset.copy = "";
    b.textContent = "Copy";
    box.append(b, pre);
  });
  copyButtons();
  // the rail marks the section you're reading
  const links = [...document.querySelectorAll<HTMLAnchorElement>(".onpage-rail a")];
  const targets = links.map((a) => document.getElementById(decodeURIComponent(a.hash.slice(1))));
  if (links.length) {
    let raf = 0;
    const mark = () => {
      raf = 0;
      // the last section whose heading has passed under the nav
      let at = -1;
      targets.forEach((t, i) => { if (t && t.getBoundingClientRect().top < 140) at = i; });
      links.forEach((a, i) => (i === at ? a.setAttribute("aria-current", "location") : a.removeAttribute("aria-current")));
    };
    addEventListener("scroll", () => { raf ||= requestAnimationFrame(mark); }, { passive: true });
    mark();
  }
</script>
</body>
</html>
