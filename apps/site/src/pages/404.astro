---
import "../styles/site.css";
import Head from "../components/Head.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import Face from "../components/Face.astro";
import { siteLinks } from "../lib/links";
const { dl, gh } = await siteLinks();
---
<!doctype html>
<html lang="en">
<Head title="Nothing here · Ducter" description="There's no page at this address." path="/404" />
<body>
<Nav dl={dl} gh={gh} home={false} />
<main id="main" class="final" style="padding-top:72px">
  <div class="wrap">
    <Face id="nf-face" faces={["napping"]} start="napping" sizes="168px" eager />
    <h2>Nothing here.</h2>
    <p class="lede">There's no page at this address, so Ducter is taking a nap.</p>
    <div class="cta-row"><a class="btn secondary lg" href="/docs">Read the docs</a><a class="btn lg" href="/">Back to the start</a></div>
  </div>
</main>
<Footer gh={gh} home={false} />
</body>
</html>
