---
import { render } from "astro:content";
import DocsLayout from "../../layouts/DocsLayout.astro";
import { publishedDocs } from "../../lib/docs";

export async function getStaticPaths() {
  const docs = await publishedDocs();
  return docs.filter((d) => d.id !== "readme").map((doc) => ({ params: { slug: doc.id }, props: { doc, docs } }));
}
const { doc, docs } = Astro.props;
const { Content } = await render(doc);
---
<DocsLayout doc={doc} docs={docs}><Content /></DocsLayout>
