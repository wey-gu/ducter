---
import "../styles/site.css";
import Art from "../components/Art.astro";
import Face from "../components/Face.astro";
import Head from "../components/Head.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import Isles from "../components/Isles.astro";
import GitHubMark from "../components/GitHubMark.astro";
import Shot from "../components/Shot.astro";
import { launchFilm, siteLinks } from "../lib/links";
import { agents, agentsByNameAnd, agentsSoonClause, agentsTasksAnd, agentsTodayAnd } from "../lib/agents";
import { homeFaq } from "../lib/faq";

// D326, D414, D558: the page answers a visitor's questions in their order: what will it do for me
// (the two-beat promise, then D414's line naming it: a personal AI for builders, on their own
// computers or servers), how does it go (one real example in three steps), what does it do for
// what I build, is it for me (and what changes), what does it do for the rest of my day, what can
// it reach, will it bother me, can I reach it, does it know me, can I trust it, is it mine, and
// the questions people ask. How it's built lives in the README ("Under the hood"), linked from
// the footer.
const { facts, dl, gh } = await siteLinks();
const film = launchFilm();
const title = "Ducter: a personal AI for builders, running your AI agents on your own computers or servers";
const description =
  "Ducter is a free, open-source personal AI for builders. It runs your AI agents (Claude Code, Codex, pi, DeepSeek Harness and more) side by side on your own computers or servers, on the plans and keys you already have, and you hear only what matters.";
const check = `<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 8.5l3.2 3L13 4.5"/></svg>`;
const ld = [
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    name: "Ducter",
    applicationCategory: "LifestyleApplication",
    operatingSystem: "macOS, Linux, iOS, iPadOS, Android",
    description,
    url: "https://ducter.ai",
    license: "https://www.apache.org/licenses/LICENSE-2.0",
    offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: homeFaq.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })),
  },
];

// D558: who Ducter is for, in lines a visitor recognises themselves in, builder first.
const forYou = [
  "You run several Claude Code or Codex sessions and lose track of which one is waiting on you.",
  "You want the work to carry on while your laptop sleeps, on a computer you own.",
  "You already pay for an AI plan, and want no second bill and no new account.",
  "You'd rather answer from your phone, or from the chat app you already use.",
  "You'd like the same partner to watch your mail and calendar, and flag the one thing that can't wait.",
  "You want to read every line of the software that holds your keys and your mail.",
];

// D639: the fifth way in, beside the four device cards. Official simple marks, drawn in the
// site's ink (not brand colours); Feishu / Lark has no Simple Icons mark, so a plain drawn speech
// bubble instead of an invented logo.
const chatApps = [
  {
    name: "iMessage",
    mark: `<path d="M5.285 0A5.273 5.273 0 0 0 0 5.285v13.43A5.273 5.273 0 0 0 5.285 24h13.43A5.273 5.273 0 0 0 24 18.715V5.285A5.273 5.273 0 0 0 18.715 0ZM12 4.154a8.809 7.337 0 0 1 8.809 7.338A8.809 7.337 0 0 1 12 18.828a8.809 7.337 0 0 1-2.492-.303A8.656 7.337 0 0 1 5.93 19.93a9.929 7.337 0 0 0 1.54-2.155 8.809 7.337 0 0 1-4.279-6.283A8.809 7.337 0 0 1 12 4.154"/>`,
  },
  {
    name: "WeChat",
    mark: `<path d="M8.691 2.188C3.891 2.188 0 5.476 0 9.53c0 2.212 1.17 4.203 3.002 5.55a.59.59 0 0 1 .213.665l-.39 1.48c-.019.07-.048.141-.048.213 0 .163.13.295.29.295a.326.326 0 0 0 .167-.054l1.903-1.114a.864.864 0 0 1 .717-.098 10.16 10.16 0 0 0 2.837.403c.276 0 .543-.027.811-.05-.857-2.578.157-4.972 1.932-6.446 1.703-1.415 3.882-1.98 5.853-1.838-.576-3.583-4.196-6.348-8.596-6.348zM5.785 5.991c.642 0 1.162.529 1.162 1.18a1.17 1.17 0 0 1-1.162 1.178A1.17 1.17 0 0 1 4.623 7.17c0-.651.52-1.18 1.162-1.18zm5.813 0c.642 0 1.162.529 1.162 1.18a1.17 1.17 0 0 1-1.162 1.178 1.17 1.17 0 0 1-1.162-1.178c0-.651.52-1.18 1.162-1.18zm5.34 2.867c-1.797-.052-3.746.512-5.28 1.786-1.72 1.428-2.687 3.72-1.78 6.22.942 2.453 3.666 4.229 6.884 4.229.826 0 1.622-.12 2.361-.336a.722.722 0 0 1 .598.082l1.584.926a.272.272 0 0 0 .14.047c.134 0 .24-.111.24-.247 0-.06-.023-.12-.038-.177l-.327-1.233a.582.582 0 0 1-.023-.156.49.49 0 0 1 .201-.398C23.024 18.48 24 16.82 24 14.98c0-3.21-2.931-5.837-6.656-6.088V8.89c-.135-.01-.27-.027-.407-.03zm-2.53 3.274c.535 0 .969.44.969.982a.976.976 0 0 1-.969.983.976.976 0 0 1-.969-.983c0-.542.434-.982.97-.982zm4.844 0c.535 0 .969.44.969.982a.976.976 0 0 1-.969.983.976.976 0 0 1-.969-.983c0-.542.434-.982.969-.982z"/>`,
  },
  {
    name: "Feishu\u00A0/ Lark",
    // No Feishu / Lark mark in Simple Icons: a plain drawn speech bubble, not an invented logo.
    mark: `<path fill-rule="evenodd" d="M4 2.25h16A2.75 2.75 0 0 1 22.75 5v9A2.75 2.75 0 0 1 20 16.75h-6.4l-4.36 3.55c-.63.51-1.57.06-1.57-.75v-2.8H4A2.75 2.75 0 0 1 1.25 14V5A2.75 2.75 0 0 1 4 2.25Zm3.3 5.15a1.35 1.35 0 1 0 0 2.7 1.35 1.35 0 0 0 0-2.7Zm5.05 0a1.35 1.35 0 1 0 0 2.7 1.35 1.35 0 0 0 0-2.7Zm5.05 0a1.35 1.35 0 1 0 0 2.7 1.35 1.35 0 0 0 0-2.7Z"/>`,
  },
  {
    name: "Telegram",
    mark: `<path d="M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.48.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z"/>`,
  },
  {
    name: "Slack",
    // Slack's own mark, from Simple Icons 15 (CC0), the last release that carried it.
    mark: `<path d="M5.042 15.165a2.528 2.528 0 0 1-2.52 2.523A2.528 2.528 0 0 1 0 15.165a2.527 2.527 0 0 1 2.522-2.52h2.52v2.52zM6.313 15.165a2.527 2.527 0 0 1 2.521-2.52 2.527 2.527 0 0 1 2.521 2.52v6.313A2.528 2.528 0 0 1 8.834 24a2.528 2.528 0 0 1-2.521-2.522v-6.313zM8.834 5.042a2.528 2.528 0 0 1-2.521-2.52A2.528 2.528 0 0 1 8.834 0a2.528 2.528 0 0 1 2.521 2.522v2.52H8.834zM8.834 6.313a2.528 2.528 0 0 1 2.521 2.521 2.528 2.528 0 0 1-2.521 2.521H2.522A2.528 2.528 0 0 1 0 8.834a2.528 2.528 0 0 1 2.522-2.521h6.312zM18.956 8.834a2.528 2.528 0 0 1 2.522-2.521A2.528 2.528 0 0 1 24 8.834a2.528 2.528 0 0 1-2.522 2.521h-2.522V8.834zM17.688 8.834a2.528 2.528 0 0 1-2.523 2.521 2.527 2.527 0 0 1-2.52-2.521V2.522A2.527 2.527 0 0 1 15.165 0a2.528 2.528 0 0 1 2.523 2.522v6.312zM15.165 18.956a2.528 2.528 0 0 1 2.523 2.522A2.528 2.528 0 0 1 15.165 24a2.527 2.527 0 0 1-2.52-2.522v-2.522h2.52zM15.165 17.688a2.527 2.527 0 0 1-2.52-2.523 2.526 2.526 0 0 1 2.52-2.52h6.313A2.527 2.527 0 0 1 24 15.165a2.528 2.528 0 0 1-2.522 2.523h-6.313z"/>`,
  },
];

// D558: the pain first, then what Ducter does about it. Every right-hand side is built today.
const beforeWith = [
  ["Ten terminal tabs, and no idea which one is waiting on you.", "One conversation. On hand shows every task, and what needs you comes to the top with what it would do."],
  ["Your laptop closes, and the agent stops.", "Ducter can live on a server you own, and keeps working while your Mac sleeps."],
  ["A question sits unanswered while you're away.", "Every question comes with the answer it would take. Go is one tap, from your phone."],
  ["You explain your project again in every session.", "Your partner remembers, and you can see what it knows."],
  ["“Done”, with nothing to show for it.", "Finished work comes with How I know: the tests that ran, the checks, the changes."],
  ["The one mail that matters hides in your inbox.", "It reads the pile for you, and brings up that one with a next step."],
];

// D558: what it can reach and use, in the person's words, each with the clay object the app
// draws for it and the page that says how. Only what is built; a part that isn't says so.
type Reach = { art: (keyof typeof import("../art.json"))[]; title: string; text: string; href: string; agentCoins?: true };
const reach: Reach[] = [
  { art: ["server_awake"], title: "Your computers and servers", text: "It lives on your Mac or a Linux server you own. Add a NAS, a cloud machine or another Mac with one line, and say where a task should run.", href: "/docs/add-a-computer" },
  { art: ["coin_claude_code", "coin_codex", "coin_pi", "coin_deepseek_harness", "coin_devin", "coin_cursor", "coin_dim", "coin_antigravity", "coin_kimi", "coin_opencode"], agentCoins: true, title: "The AI agents you have", text: `${agentsTodayAnd} can be your partner, signed in as you, on the plan or key you already have. ${agentsTasksAnd} ${agents.tasks.length > 1 ? "take" : "takes"} any task; ${agentsByNameAnd} take tasks only when you ask for them by name.${agentsSoonClause ? ` ${agentsSoonClause}.` : ""}`, href: "/docs/faq#which-ai-agents-does-it-work-with" },
  { art: ["ab_web"], title: "A real browser", text: "Its own Chrome window, apart from yours. Watch it from your phone, and take a turn when a page needs you.", href: "/docs/devices#browsing-the-web" },
  { art: ["ab_computer"], title: "Your Mac's apps", text: "It exports the Keynote deck or answers the mail in your Mac's own apps, in the background, with Stop in reach.", href: "/docs/devices#tasks-in-your-macs-apps" },
  { art: ["ab_phone", "android"], title: "A phone of its own, or yours", text: "An Android phone that runs on your Mac, for things that only happen in an app. Or a task borrows your own Android phone for a while.", href: "/docs/devices#ducters-phone" },
  { art: ["ab_call"], title: "Phone calls", text: "It rings a restaurant, a clinic or a shop for you, only after you tap Call.", href: "/docs/calls" },
  { art: ["wait_mail", "routine_calendar"], title: "Your mail and calendar", text: "Say yes once, and it reads them for you. Sending, changing or answering anything waits for your Go.", href: "/docs/accounts" },
  { art: ["set_chats"], title: "Your chat apps", text: "Talk to it from iMessage, WeChat, Feishu / Lark, Telegram or Slack. Feishu and Lark are direct messages only. It's the same conversation as in the app.", href: "/docs/chat-apps" },
  { art: ["nowledge_mem"], title: "One memory, and your other agents", text: "With Nowledge Mem, it shares one memory with your other AI tools, and the agents you open yourself can hand it work.", href: "/docs/settings#talk-with-your-other-agents" },
  { art: ["tablet"], title: "Small apps, from one sentence", text: "Ask for a trip expense tracker or a habit tracker, keep it on every device, and change it by asking.", href: "/docs/apps" },
  { art: ["set_autofill"], title: "Errands, to the checkout", text: "It books and buys with your saved sign-ins and cards, filled in without being seen. Paying is your own tap.", href: "/docs/buying-and-booking" },
  { art: ["phone"], title: "Share from your phone", text: "Send a page, a photo or a PDF to your partner from any app's Share, on iPhone and Android.", href: "/docs/pictures#share-from-another-app" },
];
---
<!doctype html>
<html lang="en">
<Head title={title} description={description} ld={ld} />
<body>
<Nav dl={dl} gh={gh} />

<main id="main">

<!-- ============ HERO: what it is, in one breath, and a real screen ============ -->
<section class="hero">
  <div class="wrap hero-grid">
    <div class="hero-copy">
      <h1>Hand it ten things. Hear back only what needs you. <span class="line quiet">A personal AI for builders, on your own computers or servers.</span></h1>
      <p class="lede lines">
        <span>You talk to one partner, from your phone, your desk or the chat app you already use.</span>
        <span>It hands the work to the AI agents you already pay for, like Claude Code or Codex, and brings it back with how it was checked.</span>
      </p>
      <div class="cta-row">
        <a class="btn lg" href="/start">Get started</a>
        <a class="btn secondary lg" href="#how">See how it goes</a>
      </div>
      <p class="facts">Free and open source. It lives on your Mac or a server you own, and anything that spends your money or reaches other people waits for your OK.</p>
    </div>
    <figure class="hero-shot">
      <Shot name="hero" width={1080} height={1350} eager sizes="(min-width: 1280px) 520px, (min-width: 1040px) 480px, 92vw"
        alt="Ducter's conversation. Its morning note: ducter.dev expires on Nov 16 and isn't renewed yet, with Open the renewal page and Hold; you land in Tokyo on Nov 21 but the hotel starts on the 22nd, with Find a place to stay and Hold. Below, you asked it to book a table for four on Saturday somewhere your mother can get into without stairs; it says it's booked at 7:15 on the ground floor, the confirmation is in your mail, and it's free to cancel until Friday noon." />
      <figcaption>A morning in Ducter: two things it noticed in your mail, and an errand you handed it, done.</figcaption>
    </figure>
  </div>
</section>

<!-- ============ HOW IT GOES: one real job, in three steps (D558) ============ -->
<section class="sec how" id="how">
  <div class="wrap">
    <div class="sec-head">
      <h2>How it goes.</h2>
    </div>
    <ol class="does how-steps">
      <li class="card reveal">
        <div class="card-art"><Art name="ducter_idle" alt="" sizes="120px" /></div>
        <h3>You say it</h3>
        <p class="eg">“Fix the flaky compaction test in HawDB, and tell me when it's done.”</p>
        <p>Then three more things, one after another. No setup for each.</p>
      </li>
      <li class="card reveal">
        <div class="card-art"><Art name="ducter_working" alt="" sizes="120px" /></div>
        <h3>It hands it off</h3>
        <p>Each one becomes a task on an AI agent you already use, such as Claude Code or Codex, signed in as you, on your Mac or your server. Coding tasks get their own branch. While they work, you hear nothing.</p>
      </li>
      <li class="card reveal">
        <div class="card-art"><Art name="ducter_done" alt="" sizes="120px" /></div>
        <h3>You decide</h3>
        <p class="eg">“Fixed: 50 of 50 runs pass, and so do the 412 workspace tests.”</p>
        <p>You read how it knows, and tap <b>Merge into main</b>. Or don't: nothing lands without you.</p>
      </li>
    </ol>
  </div>
</section>

<!-- ============ MANY AT ONCE: the work half (D414) ============ -->
<section class="sec deep" id="many">
  <div class="wrap">
    <div class="sec-head">
      <h2>For what you build: a whole team of AI agents.</h2>
      <p class="lede">Each thing you hand it becomes a task with an AI agent of its own, running side by side on your computers or servers. You don't watch any of them: what needs you comes to the top with what it would do, and the rest stays quiet until it's done.</p>
    </div>
    <div class="wide-shot many-shot reveal">
      <Shot name="many" width={1920} height={1000} phone={{ width: 780, height: 1454 }} sizes="(min-width: 1180px) 1080px, 94vw"
        alt="Tasks at full width: 6 things need you across 18 tasks in hawdb, ducter, mem, Receipts and Other. The first asks whether to rebase before running the tests, with Rebase, Not now, Reply and Ask me later; the second asks you to sign in to App Store Connect in Chrome. On the right, the peek shows PR #1592, fix the compaction test, at work." />
    </div>
    <ul class="points three">
      <li><span><b>Open any task, any time.</b> See every step and every change, steer it in your own words, or hand it to another AI agent mid-way.</span></li>
      <li><span><b>Every question comes with a default.</b> Tap Go on all of them at once, or let the ones that can be undone go ahead on their own.</span></li>
      <li><span><b>Your code stays as you left it.</b> Each coding task works in its own copy, on its own branch, and merging is always your call.</span></li>
    </ul>
  </div>
</section>

<!-- ============ IS IT FOR YOU: who, and what changes (D558) ============ -->
<section class="sec" id="fit">
  <div class="wrap fit">
    <div>
      <div class="sec-head">
        <h2>Ducter is for you if</h2>
      </div>
      <ul class="checks">
        {forYou.map((line) => <li><span class="ck" set:html={check} /><span>{line}</span></li>)}
      </ul>
    </div>
    <div class="bw reveal">
      <table>
        <caption>Before Ducter, and with it</caption>
        <thead><tr><th scope="col">Before</th><th scope="col">With Ducter</th></tr></thead>
        <tbody>
          {beforeWith.map(([before, withIt]) => <tr><td data-label="Before">{before}</td><td data-label="With Ducter">{withIt}</td></tr>)}
        </tbody>
      </table>
    </div>
  </div>
</section>

<!-- ============ WHAT IT DOES FOR YOU ============ -->
<section class="sec deep" id="what">
  <div class="wrap">
    <div class="sec-head">
      <h2>For the rest of your day: a partner that looks out for you.</h2>
      <p class="lede">One partner, one conversation. You say what you want in plain words; it works out the rest and comes back with the result.</p>
    </div>
    <ul class="does">
      <li class="card reveal">
        <div class="card-art"><Art name="ducter_needsyou" alt="" sizes="120px" /></div>
        <h3>It looks out for you</h3>
        <p>Say yes once, and it keeps an eye on your mail, calendar and chats. Each morning it brings you <b>at most three things</b> that need you, each with a next step. On a quiet day, nothing.</p>
        <p class="eg">“Your flight lands the night before your hotel starts.”</p>
      </li>
      <li class="card reveal">
        <div class="card-art"><Art name="ducter_working" alt="" sizes="120px" /></div>
        <h3>It does the work</h3>
        <p>Research, documents, a pile of receipts to sort, a trip to plan. It hands each job to an AI agent on your computer and comes back with what it did and how it checked. Open any job to see every step, and steer it yourself.</p>
        <p class="eg">“Put October's receipts in a spreadsheet.”</p>
      </li>
      <li class="card reveal">
        <div class="card-art"><Art name="ab_call" alt="" sizes="120px" /></div>
        <h3>It runs errands</h3>
        <p>It looks things up in its own browser, fills in forms with your saved details, makes bookings, and can even phone a restaurant for you. You see exactly what it will do, and tap Go.</p>
        <p class="eg">“Book a table for two on Friday.”</p>
      </li>
    </ul>
  </div>
</section>

<!-- ============ YOUR COMPUTERS, YOUR AI, AND WHAT IT CAN REACH (D558) ============ -->
<section class="sec" id="devices">
  <div class="wrap">
    <div class="sec-head">
      <h2>On your computers, and as far as you let it reach.</h2>
      <p class="lede">Ducter lives on your Mac or on a server you own, and works through the AI agents you are already signed in to. There is no Ducter account to make and nothing to pay us. From there it can reach a browser, your Mac's apps, a phone, your mail and your chat apps, each one only once you say so.</p>
    </div>

    <div class="stage-wrap reveal">
      <Isles />

      <div class="tray">
        <h3>You can also add</h3>
        <div class="stickers">
          <button class="sticker live" id="sticker-web" type="button" aria-describedby="web-detail"><Art name="ab_web" alt="" sizes="(min-width: 1040px) 96px, (min-width: 560px) 15vw, 19vw" /><b>Browse the web</b><small id="web-small">Drag onto this Mac, or tap</small></button>
          <div class="sticker"><Art name="ab_computer" alt="" sizes="(min-width: 1040px) 96px, (min-width: 560px) 15vw, 19vw" /><b>Use the computer</b><small>Works in your Mac's apps</small></div>
          <div class="sticker"><Art name="ab_phone" alt="" sizes="(min-width: 1040px) 96px, (min-width: 560px) 15vw, 19vw" /><b>Use a phone</b><small>A phone of its own, on your Mac</small></div>
          <div class="sticker"><Art name="ab_call" alt="" sizes="(min-width: 1040px) 96px, (min-width: 560px) 15vw, 19vw" /><b>Make calls</b><small>It phones for you once you say Call</small></div>
        </div>
        <div class="detail" id="web-detail">
          <h3>Browse the web</h3>
          <p>This Mac can look things up and read pages in Ducter's own Chrome window, apart from yours. Signing in, submitting forms and paying stay with you.</p>
          <button class="btn md" type="button" id="equip">Add to this Mac</button>
        </div>
      </div>
    </div>

    <div class="reach" id="reach">
      <h3>Everything it can reach</h3>
      <ul class="reach-grid">
        {reach.map((r) => (
          <li>
            <a class="reach-card" href={r.href}>
              <span class={`reach-art${r.art.length > 2 ? " coins" : ""}${r.agentCoins ? " agents" : ""}`}>
                {r.agentCoins ? (
                  <>
                    <span class="coin-row partner">{r.art.slice(0, 4).map((n) => <Art name={n} alt="" sizes="40px" />)}</span>
                    <span class="coin-row more">{r.art.slice(4).map((n) => <Art name={n} alt="" sizes="26px" />)}</span>
                  </>
                ) : (
                  r.art.map((n) => <Art name={n} alt="" sizes={r.art.length > 2 ? "40px" : "72px"} />)
                )}
              </span>
              <b>{r.title}</b>
              <span class="reach-text">{r.text}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<!-- ============ IT ONLY ASKS WHEN IT MATTERS ============ -->
<section class="sec deep" id="asks">
  <div class="wrap split">
    <div>
      <div class="sec-head">
        <h2>It only asks when it matters.</h2>
      </div>
      <p class="lede">No stream of pings, however many tasks are running. You hear back when something is done or a decision is yours to make, on whichever device is in your hand.</p>
      <ul class="points">
        <li><span><b>Go or Hold, in one tap.</b> Or reply in your own words.</span></li>
        <li><span><b>Or don't answer at all.</b> If its suggestion can be undone, it goes ahead after 30 minutes. Anything else waits for you.</span></li>
        <li><span><b>Quiet hours are quiet.</b> Your phone stays still from 23:00 to 08:00 unless you say otherwise.</span></li>
      </ul>
    </div>
    <div class="phone-shot reveal">
      <Shot name="onhand-phone" width={780} height={1600} sizes="(min-width: 980px) 320px, 72vw"
        alt="Tasks on a phone: 2 things need you. ducter.dev expires on Nov 16 and isn't renewed yet, with Open the renewal page, Not now and Reply. You land in Tokyo on Nov 21 but the hotel starts on the 22nd, with Find a place to stay, Not now and Reply." />
    </div>
  </div>
</section>

<!-- ============ REACH IT ANYWHERE ============ -->
<section class="sec" id="where">
  <div class="wrap">
    <div class="sec-head">
      <h2>Reach it from anywhere.</h2>
      <p class="lede">It's one conversation wherever you open it. Start something at your desk, answer its question from your phone, read the result on your iPad, or just message it from the chat app you already live in.</p>
    </div>
    <ul class="where">
      <li class="where-card reveal">
        <div class="where-art"><Art name="laptop_awake" alt="" sizes="160px" /></div>
        <h3>Mac</h3>
        <p>The desktop app, for a Mac with Apple silicon (M1 or later). Ducter can live here and work here.</p>
        <p class="where-state"><b>Ready</b><a href={dl.href}>Download</a></p>
      </li>
      <li class="where-card reveal">
        <div class="where-art"><Art name="phone" alt="" sizes="80px" /></div>
        <h3>iPhone and iPad</h3>
        <p>One app for both, with a nudge only when something waits for you.</p>
        <p class="where-state"><b>Public beta</b><a href="https://testflight.apple.com/join/Z4GvWt7t" rel="noopener">Join on TestFlight</a></p>
      </li>
      {facts.apkUrl ? (
        <li class="where-card reveal">
          <div class="where-art"><Art name="android" alt="" sizes="80px" /></div>
          <h3>Android</h3>
          <p>Download the app here; it keeps itself up to date.</p>
          <p class="where-state"><b>Ready</b><a href="/download">Get the app</a></p>
        </li>
      ) : (
        <li class="where-card soon reveal">
          <div class="where-art"><Art name="android" alt="" sizes="80px" /></div>
          <h3>Android</h3>
          <p>Today Ducter opens in your phone's browser.</p>
          <p class="where-state"><b>App coming soon</b><a href="/docs/phone">Use the browser</a></p>
        </li>
      )}
      <li class="where-card reveal">
        <div class="where-art"><Art name="server_awake" alt="" sizes="150px" /></div>
        <h3>A Linux server</h3>
        <p>At home or in the cloud, so your partner keeps working while your Mac sleeps.</p>
        <p class="where-state"><b>Ready</b><a href="/docs/install#a-linux-server-that-stays-on">Set one up</a></p>
      </li>
    </ul>
    <div class="chats reveal">
      <div class="chats-copy">
        <h3>And in the chat apps you already use.</h3>
        <p>Message your partner there: the same conversation, and only you can talk to it.</p>
      </div>
      <ul class="chat-apps" aria-label="Chat apps">
        {chatApps.map((app) => (
          <li class="chat-app">
            <span class="chat-tile" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="currentColor" focusable="false" set:html={app.mark} />
            </span>
            <span class="chat-name">{app.name}</span>
          </li>
        ))}
      </ul>
      <a class="chats-link" href="/docs/chat-apps">Set one up</a>
    </div>
  </div>
</section>

<!-- ============ IT REMEMBERS YOU ============ -->
<section class="sec deep" id="memory">
  <div class="wrap split flip">
    <div>
      <div class="sec-head">
        <h2>It remembers you.</h2>
      </div>
      <p class="lede">Tell it once how you like things, and it keeps to it next week, in every job. It doesn't start from zero, and you can always see what it knows.</p>
      <ul class="points">
        <li><span><b>Every line says where it came from:</b> you told it, it picked it up from your conversations, or another AI tool you use saved it.</span></li>
        <li><span><b>Fix it or have it forgotten,</b> one line at a time, or turn memory off.</span></li>
        <li><span><b>One memory for all your AIs.</b> With <a href="https://mem.nowledge.co" rel="noopener">Nowledge Mem</a>, what you decided in one AI tool is known in the others too. <span class="when">Optional, and free to download.</span></span></li>
      </ul>
    </div>
    <div class="sheet-shot reveal">
      <Shot name="memory" width={960} height={1056} sizes="(min-width: 980px) 480px, 92vw"
        alt="Settings, Memory: Ducter remembers you, 5 new this week. What it knows about you, How you like things: Likes the conclusion first, details after (you told it); Chat in Chinese, docs and code in the repo in English (saved by Codex); English mail short and plain (Nowledge Mem drew it from your conversations)." />
    </div>
  </div>
</section>

<!-- ============ TRUST AND PRIVACY ============ -->
<section class="sec ink-band" id="trust">
  <div class="wrap">
    <div class="sec-head">
      <h2>Nothing goes out without your OK.</h2>
      <p class="lede">Reading and drafting are fine. Anything that sends, pays, calls or can't be taken back shows you exactly what will happen, and waits for you. Afterwards, <b>Done for you</b> lists all of it, day by day.</p>
    </div>
    <div class="trust-grid">
      <div class="wide-shot reveal">
        <Shot name="done-for-you" width={1380} height={1056} sizes="(min-width: 1040px) 640px, 92vw"
          alt="Done for you: today, sent, paid, called, filled in, changed and looked at. Rows: changed 14 files in the task Sort the invoices folder, with Undo until Nov 24; merged a branch after you said Go; added a Dentist event after you said Go; called Sushi Saito to book Saturday 7 pm for two." />
      </div>
      <ul class="nevers">
        <li><b>It never sees your passwords.</b><span>It fills a saved sign-in only on its own site, or you sign in yourself.</span></li>
        <li><b>It never pays on its own.</b><span>Every payment shows the shop, the amount and the card, and waits for your OK.</span></li>
        <li><b>It never merges your code.</b><span>A finished job offers Merge into main, and waits for you.</span></li>
        <li><b>Your conversation stays with you.</b><span>It's kept on your own computer. It reaches an AI only through your own account, and a chat app only if you connect one.</span></li>
      </ul>
    </div>
    <p class="body more">The whole story is in <a href="/docs/privacy-and-safety">Privacy and safety</a>.</p>
  </div>
</section>

<!-- ============ OPEN AND YOURS ============ -->
<section class="sec" id="open">
  <div class="wrap">
    <div class="sec-head">
      <h2>Open source, and yours.</h2>
    </div>
    <div class="cards3">
      <div class="card reveal"><div class="card-art"><Art name="ducter_done" alt="" sizes="120px" /></div><h3>Free and open source</h3><p>Under the Apache 2.0 license. Every line, and every word Ducter tells an AI on your behalf, is there to read.</p></div>
      <div class="card reveal"><div class="card-art"><Art name="server_awake" alt="" sizes="140px" /></div><h3>Runs where you put it</h3><p>Your Mac, or a Linux server you own. Nobody can switch it off for you or change the deal.</p></div>
      <div class="card reveal"><div class="card-art coins"><Art name="coin_claude_code" alt="" sizes="64px" /><Art name="coin_codex" alt="" sizes="64px" /><Art name="coin_pi" alt="" sizes="64px" /><Art name="coin_deepseek_harness" alt="" sizes="64px" /></div><h3>No lock-in</h3><p>It works through whichever AI agent you have, on your own plan. Change your mind any time; your partner and its memory come along.</p></div>
    </div>

    <div class="get" id="install">
      <div>
        <h3>Ready when you are</h3>
        <p class="body"><b>Get started</b> asks one question, where Ducter should live, and shows you just that path. Let the AI agent you already use set it up with one sentence, or do it yourself in a few minutes.</p>
      </div>
      <div class="cta-row">
        <a class="btn lg" href="/start">Get started</a>
        <a class="btn secondary lg" href="/download">Every download</a>
      </div>
    </div>
  </div>
</section>

<!-- ============ QUESTIONS (D558; the same words are the page's FAQPage data) ============ -->
<section class="sec deep" id="faq">
  <div class="wrap faq">
    <div class="sec-head">
      <h2>Questions people ask.</h2>
    </div>
    <div class="faq-list">
      {homeFaq.map((f) => (
        <details class="fold">
          <summary><span class="fold-q">{f.q}</span></summary>
          <div class="fold-body">
            <p>{f.a}</p>
            <a class="fold-more" href={f.more.href}>{f.more.label}</a>
          </div>
        </details>
      ))}
    </div>
    <p class="body more">More in <a href="/docs/faq">Questions people ask</a>, and the whole picture in <a href="/docs/concepts">How Ducter fits together</a>.</p>
  </div>
</section>

<section class="final" id="final">
  <div class="wrap">
    <Face id="final-face" faces={["napping", "idle"]} start="napping" sizes="168px" />
    <h2>Hand it something today.</h2>
    <p class="lede">Then get on with your day. It tells you when it's done, and asks only when it matters.</p>
    <figure class="film">
      {film.src ? (
        <video src={film.src} poster={film.poster} width="960" height="540" controls preload="none" playsinline aria-label="A one-minute film about Ducter"></video>
      ) : (
        <a class="film-poster" href={film.release} rel="noopener"><img src={film.poster} width="960" height="540" alt="A one-minute film about Ducter. Opens on GitHub." loading="lazy" decoding="async" /></a>
      )}
    </figure>
    <div class="cta-row">
      <a class="btn secondary lg gh" href={gh.href} rel="noopener"><GitHubMark />Star on GitHub</a>
      <a class="btn lg" href="/start">Get started</a>
    </div>
  </div>
</section>
</main>

<Footer gh={gh} />

