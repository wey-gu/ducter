      </figure>
    )}
    <div class="cta-row">
      <a class="btn secondary lg gh" href={gh.href} rel="noopener"><GitHubMark />Star on GitHub</a>
      <a class="btn lg" href={dl.href}>{dl.label}</a>
    </div>
  </div>
</section>
</main>

