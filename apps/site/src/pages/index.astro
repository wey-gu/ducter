            <div class="file"><span>⌄ crates/storage/tests/checkpoint_recovery.rs</span> <span class="n"><span class="add">+3</span> <span class="del">−3</span></span></div>
<pre><span>    let wal = Wal::open(&amp;dir, WalOptions::fsync_each())?;</span><span>    let seq = wal.append(b"hello")?;</span><span class="del">-   std::thread::sleep(Duration::from_millis(50));</span><span class="add">+   // wait for the flusher instead of a fixed sleep</span><span class="add">+   wal.wait_durable(seq)?;</span><span>    crash_and_reopen(&amp;dir)?;</span><span>    assert_eq!(recovered.last_seq(), seq);</span></pre>
