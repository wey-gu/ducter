{
  "name": "ducter",
  "private": true,
  "type": "module",
  "workspaces": ["packages/*", "apps/web"],
  "scripts": {
    "up": "bun run packages/core/src/main.ts",
    "ducter": "bun packages/cli/src/main.ts",
    "build:cli": "sh packages/cli/build.sh",
    "test": "bun test --timeout 20000",
    "eval:partner": "bun packages/partner/eval/run.ts",
    "eval:compare": "bun packages/partner/eval/compare.ts",
    "bridge:live": "bun packages/partner/eval/bridge-live.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p apps/web/tsconfig.json",
    "build:web": "sh scripts/build-web.sh",
    "e2e:linux": "bun scripts/e2e/linux.ts"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "@types/bun": "latest"
  },
  "patchedDependencies": {
    "@botiverse/oar@0.124.0": "patches/@botiverse%2Foar@0.124.0.patch"
  }
}
